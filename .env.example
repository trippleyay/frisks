# --- LLM provider (interchangeable, config-only) ---
# "groq" or "deepseek". Whichever is configured first is used; the other
# is used as an automatic fallback if the primary provider call fails.
FRISKS_LLM_PROVIDER=groq

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

FRISKS_LLM_TIMEOUT_S=20
FRISKS_LLM_MAX_RETRIES=2

# --- Binance EAPI (public, no key needed) ---
BINANCE_EAPI_BASE_URL=https://eapi.binance.com
FRISKS_BINANCE_TIMEOUT_S=10
FRISKS_BINANCE_MAX_RETRIES=4
FRISKS_BINANCE_BACKOFF_BASE_S=0.5
FRISKS_BINANCE_BACKOFF_MAX_S=8

# --- Caching (open item — see config.py for rationale) ---
FRISKS_CACHE_EXCHANGE_INFO_TTL_S=300
FRISKS_CACHE_TICKER_TTL_S=5
FRISKS_CACHE_MARK_TTL_S=5
FRISKS_CACHE_OI_TTL_S=15

# --- Liquidity thresholds (tunable, verified only on BTC/ETH single expiry) ---
FRISKS_LIQ_MIN_VOLUME_24H=1.0
FRISKS_LIQ_MAX_SPREAD_PCT=0.15
FRISKS_LIQ_REQUIRE_BID=true
FRISKS_LIQ_PENALTY_PERCENTILE=0.10
FRISKS_LIQ_PENALTY_MULTIPLIER=0.85

# --- Engine ---
FRISKS_DEFAULT_MAX_LEGS=4
FRISKS_DEFAULT_MAX_EXPIRIES=2
FRISKS_TOP_N_RESULTS=3
FRISKS_DIST_GRID_POINTS=400
FRISKS_DIST_GRID_SIGMAS=6
# Cap on how many multi-expiry candidates get the expensive payoff-model
# budget check per request (ranked by cheap intrinsic worst-case loss).
# Raise if it's dropping good candidates too aggressively; lower if a
# request is still too slow.
FRISKS_MAX_EXPENSIVE_CHECKS=300

FRISKS_LOG_LEVEL=INFO
FRISKS_B402_ENABLED=false

FRISKS_HOST=0.0.0.0
FRISKS_PORT=8000
